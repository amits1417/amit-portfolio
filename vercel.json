{
  "cleanUrls": false,
  "functions": {
    "api/streamable.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/edit", "destination": "/index.html?edit" },
    { "source": "/admin", "destination": "/index.html?edit" },
    { "source": "/cms", "destination": "/index.html?edit" }
  ],
  "headers": [
    {
      "source": "/(assets|node_modules)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|mp4|webm|woff2|woff|ttf|ico|webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(app\\.js|style\\.css|index\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0, s-maxage=0, proxy-revalidate"
        }
      ]
    }
  ]
}
