{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/edit", "destination": "/index.html?edit" },
    { "source": "/admin", "destination": "/index.html?edit" },
    { "source": "/cms", "destination": "/index.html?edit" }
  ],
  "headers": [
    {
      "source": "/(assets|node_modules)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|mp4|webm|woff2|woff|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
